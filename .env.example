# ---- Browser (public, bundled into the site; never put a secret here) ----
# Optional. Public URL of the old FastAPI gateway in services/tutor. A URL, never a secret.
VITE_TUTOR_URL=
# Optional. `remote` makes the browser call the same-origin /api/hint function; `local` forces the offline guide.
# Normally leave this unset: vite.config.ts picks `remote` when TUTOR_API_KEY is set for the build (Vercel exposes
# project environment variables to the build) and `local` otherwise. Only the word is embedded, never the key.
VITE_TUTOR_MODE=

# ---- Server only: set these in Vercel > Project Settings > Environment Variables (Production), then redeploy ----
# Never commit real values. These are read by api/hint.js (built from server/tutor) and are not exposed to the browser.
# One of: openai | anthropic | gemini | openrouter
TUTOR_PROVIDER=
# The provider's model id. There is no default on purpose: model names change. Use one from your provider's model list.
TUTOR_MODEL=
# The provider API key. Set a spend limit with the provider as well.
TUTOR_API_KEY=
# Optional. Comma-separated exact origins allowed to call /api/hint. Default: https://wonderverse-ai.vercel.app
# Add a preview URL here to try the tutor on a preview deployment. A wildcard is ignored.
TUTOR_ALLOWED_ORIGINS=
# Optional. Requests per minute per client IP per function instance (default 20).
TUTOR_RATE_LIMIT=
