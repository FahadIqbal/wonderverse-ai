# Copy to .env (git-ignored). Placeholders only. Never commit a real key.
# Server-side provider key. When empty, POST /hint returns 503 and the browser falls back to the local guide.
TUTOR_API_KEY=
# Comma-separated list of exact browser origins allowed to call the gateway.
TUTOR_ALLOWED_ORIGINS=http://localhost:5173
# Requests per client IP per window.
TUTOR_RATE_LIMIT=20
TUTOR_RATE_WINDOW_SECONDS=60
# Largest accepted request body, in bytes.
TUTOR_MAX_BODY_BYTES=8192
# Seconds to wait for the provider before answering 504.
TUTOR_PROVIDER_TIMEOUT_SECONDS=4
